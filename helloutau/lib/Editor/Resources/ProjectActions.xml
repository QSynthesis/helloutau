<?xml version="1.0" encoding="UTF-8"?>
<!-- The menus, the tool bar and the commands of the project window, registered with the action
     registry of the project windows. The commands that the voice bank window has as well are
     declared again in VoiceBankActions.xml, since each kind of window has a registry of its own
     and the shortcuts of the two are set apart. Format: docs/action-extension-spec.md in
     QActionKit. -->
<actionExtension>
    <version>1.0</version>
    <id>helloutau.project</id>

    <configuration>
        <vars>
            <var key="APP_NAME" value="HelloUtau" />
        </vars>
        <translationContext
            text="hello::daw::ActionText"
            category="hello::daw::ActionCategory"
            description="hello::daw::ActionDescription"
        />
    </configuration>

    <items>
        <phony id="helloutau.catalog.plugins" text="Plugins" />
        <action id="helloutau.file.new" text="&amp;New" category="File" shortcut="Ctrl+N" />
        <action id="helloutau.file.open" text="&amp;Open..." category="File" shortcut="Ctrl+O" />
        <!-- A folder, opened in a voice bank window (docs/VoiceBankEditor.md) -->
        <action id="helloutau.file.openVoiceBank" text="Open &amp;Voice Bank..." category="File" />
        <!-- Filled by the window with the files last opened -->
        <action id="helloutau.file.openRecent" text="Open &amp;Recent" category="File"
                external="true" />
        <!-- Every recent project, or every recent voice bank, in a command palette. These
             commands are in no menu, only in the command palette, like the "More" items of Open
             Recent. -->
        <action id="helloutau.file.openRecentProject" text="Open Recent &amp;Project..."
                category="File" catalog="helloutau.file" />
        <action id="helloutau.file.openRecentVoiceBank" text="Open Recent &amp;Voice Bank..."
                category="File" catalog="helloutau.file" />
        <!-- Forgets every recent project and voice bank after a confirmation, as "Clear
             Recently Opened..." of VS Code. The command is in no menu, and Open Recent has an
             item of its own. -->
        <action id="helloutau.file.clearRecent" text="&amp;Clear Recently Opened..."
                category="File" catalog="helloutau.file" />
        <action id="helloutau.file.save" text="&amp;Save" category="File" shortcut="Ctrl+S" />
        <action id="helloutau.file.saveAs" text="Save &amp;As..." category="File"
                shortcut="Ctrl+Shift+S" />
        <!-- UST... in the Export menu, and Export UST... in the command palette -->
        <action id="helloutau.file.exportUst" text="Export &amp;UST..." shortText="&amp;UST..."
                category="File" />
        <!-- The name, tempo, flags, output file, voice folder, synth tools and Mode2 of the project -->
        <action id="helloutau.file.properties" text="Project &amp;Properties..." category="File" />
        <action id="helloutau.file.close" text="&amp;Close" category="File" shortcut="Ctrl+W" />
        <action id="helloutau.file.quit" text="&amp;Quit" category="File" shortcut="Ctrl+Q" />

        <action id="helloutau.edit.undo" text="&amp;Undo" category="Edit" shortcut="Ctrl+Z" />
        <action id="helloutau.edit.redo" text="&amp;Redo" category="Edit"
                shortcuts="Ctrl+Y;Ctrl+Shift+Z" />
        <action id="helloutau.edit.delete" text="&amp;Delete" category="Edit"
                shortcuts="Del;Shift+Del" />
        <!-- The find bar over the piano roll, as the find widget of VS Code, for the lyrics -->
        <action id="helloutau.edit.find" text="&amp;Find" category="Edit" shortcut="Ctrl+F" />
        <action id="helloutau.edit.replace" text="Rep&amp;lace" category="Edit"
                shortcut="Ctrl+H" />
        <action id="helloutau.edit.findNext" text="Find &amp;Next" category="Edit"
                shortcut="F3" />
        <action id="helloutau.edit.findPrevious" text="Find Pre&amp;vious" category="Edit"
                shortcut="Shift+F3" />
        <action id="helloutau.edit.insertNote" text="&amp;Insert Note" category="Edit"
                shortcut="Ins" />
        <action id="helloutau.edit.splitNote" text="S&amp;plit Note..." category="Edit" />
        <!-- A rest before the first selected note, as UTAU inserts one -->
        <action id="helloutau.edit.insertRest" text="Insert &amp;Rest" category="Edit"
                shortcut="Ctrl+R" />
        <!-- The selected notes into the first, their lengths summed, as UTAU combines them -->
        <action id="helloutau.edit.combineNotes" text="Com&amp;bine Notes" category="Edit"
                shortcut="Ctrl+U" />
        <!-- The tempo of the first selected note, from which it applies -->
        <action id="helloutau.edit.setTempo" text="Set Te&amp;mpo..." category="Edit" />
        <action id="helloutau.edit.replaceLyrics" text="Replace &amp;Lyrics..." category="Edit"
                shortcut="Ctrl+L" />
        <!-- The label of a note and the name of a region, as UTAU shows them on the timeline -->
        <action id="helloutau.edit.setLabel" text="Set La&amp;bel..." category="Edit" />
        <action id="helloutau.edit.nameRegion" text="Name Re&amp;gion..." category="Edit" />
        <action id="helloutau.edit.removeLabel" text="Remove Label" category="Edit" />
        <action id="helloutau.edit.removeRegion" text="Remove Region" category="Edit" />
        <!-- The properties of the selected notes, as the note property dialog of UTAU -->
        <action id="helloutau.edit.noteProperties" text="Note Propert&amp;ies..." category="Edit"
                shortcut="Ctrl+E" />
        <!-- Checked while the project turns Mode2 on -->
        <action id="helloutau.edit.mode2" text="Mode&amp;2 Pitch" category="Edit" />
        <action id="helloutau.edit.pitchControl" text="Pitch &amp;Control..." category="Edit"
                shortcut="Ctrl+T" />
        <action id="helloutau.edit.scalePitch" text="Scale Pitc&amp;h..." category="Edit" />
        <action id="helloutau.edit.convertPitchToMode1" text="Convert Mode2 Pitch to Mode&amp;1"
                category="Edit" />
        <action id="helloutau.edit.crossfadeP2P3" text="Crossfade (p&amp;2, p3)" category="Envelope" />
        <action id="helloutau.edit.crossfadeP1P4" text="Crossfade (p&amp;1, p4)" category="Envelope" />
        <action id="helloutau.edit.copy" text="&amp;Copy" category="Edit" shortcut="Ctrl+C" />
        <action id="helloutau.edit.paste" text="&amp;Paste" category="Edit" shortcut="Ctrl+V" />
        <action id="helloutau.edit.pasteParameters" text="Paste Para&amp;meters..." category="Edit"
                shortcut="Ctrl+Shift+V" />
        <action id="helloutau.edit.resetPortamento" text="&amp;Pitch Points" category="Reset" />
        <action id="helloutau.edit.resetVibratos" text="&amp;Vibratos" category="Reset" />
        <action id="helloutau.edit.resetEnvelopes" text="Reset &amp;Envelopes"
                shortText="&amp;Envelopes" category="Reset" />
        <action id="helloutau.edit.resetAll" text="&amp;All" category="Reset" />
        <action id="helloutau.edit.editLyric" text="Edit &amp;Lyric" category="Edit"
                shortcut="F2" />
        <action id="helloutau.edit.transposeUp" text="&amp;Up a Semitone" category="Transpose"
                shortcut="Ctrl+Up" />
        <action id="helloutau.edit.transposeDown" text="&amp;Down a Semitone"
                category="Transpose" shortcut="Ctrl+Down" />
        <action id="helloutau.edit.octaveUp" text="Up an &amp;Octave" category="Transpose"
                shortcut="Ctrl+Shift+Up" />
        <action id="helloutau.edit.octaveDown" text="Down an O&amp;ctave" category="Transpose"
                shortcut="Ctrl+Shift+Down" />
        <action id="helloutau.select.selectTool" text="&amp;Select Tool" category="Select"
                shortcut="V" />
        <action id="helloutau.select.penTool" text="P&amp;en Tool" category="Select" shortcut="B" />
        <action id="helloutau.select.pitchTool" text="&amp;Freehand Pitch Tool" category="Select"
                shortcut="F" />
        <!-- The grid to which drags snap, a box in the tool bar. The two commands step through
             its choices, from a quarter note to a sixty-fourth and off. -->
        <action id="helloutau.select.quantizationWidget" text="Quantization" category="Select" />
        <action id="helloutau.edit.projectTempoWidget" text="Project Tempo" category="Project" />
        <action id="helloutau.select.decreaseQuantizationInterval"
                text="&amp;Decrease Quantization Interval"
                category="Select" shortcut="Ctrl+[" />
        <action id="helloutau.select.increaseQuantizationInterval"
                text="&amp;Increase Quantization Interval"
                category="Select" shortcut="Ctrl+]" />
        <action id="helloutau.select.selectAll" text="Select &amp;All" category="Select"
                shortcut="Ctrl+A" />

        <!-- The tool bar of the project window, shown or hidden as the settings store it -->
        <action id="helloutau.view.showToolBar" text="Show &amp;Toolbar" category="View" />
        <action id="helloutau.view.timeSignature" text="Time Signature..." category="View" />
        <action id="helloutau.view.timeSignatureWidget" text="Time Signature" category="View" />
        <!-- X as in UTAU -->
        <action id="helloutau.view.showPitch" text="Show &amp;Pitch" category="View"
                shortcut="X" />
        <!-- The pitch that the resampler receives, dashed, over the whole sample of each note -->
        <action id="helloutau.view.showRenderedPitch" text="Show &amp;Rendered Pitch"
                category="View" />
        <!-- The envelope of each note above its bar, from where its pre-utterance starts, as
             UTAU draws it -->
        <action id="helloutau.view.showEnvelopes" text="Show &amp;Envelopes" category="View" />
        <!-- The modulation and the flags of each note below its bar, as UTAU shows them, with Z
             as in UTAU -->
        <action id="helloutau.view.showParameters" text="Show P&amp;arameters" category="View"
                shortcut="Z" />
        <action id="helloutau.view.goToStart" text="Go to &amp;Start" category="View"
                shortcut="Ctrl+Home" />
        <action id="helloutau.view.goToEnd" text="Go to &amp;End" category="View"
                shortcut="Ctrl+End" />
        <action id="helloutau.view.goToFirstNote" text="Go to &amp;First Note" category="View"
                shortcut="Home" />
        <action id="helloutau.view.goToLastNote" text="Go to &amp;Last Note" category="View"
                shortcut="End" />
        <action id="helloutau.view.zoomInTime" text="Zoom In &amp;Horizontally" category="View" />
        <action id="helloutau.view.zoomOutTime" text="Zoom Out Horizontall&amp;y" category="View" />
        <action id="helloutau.view.zoomInKeys" text="Zoom In &amp;Vertically" category="View" />
        <action id="helloutau.view.zoomOutKeys" text="Zoom Out Verticall&amp;y" category="View" />
        <!-- Filled by the window with the regions of the project, each of which it loads -->
        <action id="helloutau.view.loadRegion" text="&amp;Load Region" category="View"
                external="true" />
        <action id="helloutau.view.commandPalette" text="&amp;Command Palette..." category="Help"
                shortcuts="Ctrl+Shift+P;F1" />

        <!-- Plays, pauses what plays, or goes on from where it was paused -->
        <action id="helloutau.playback.play" text="&amp;Play or Pause" category="Playback"
                shortcuts="Space;F5" />
        <action id="helloutau.playback.stop" text="&amp;Stop" category="Playback" shortcut="F7" />
        <!-- Plays the last playback again from its start, the last render without the synth tools
             while its notes stay the same -->
        <action id="helloutau.playback.replay" text="&amp;Replay" category="Playback"
                shortcut="Shift+F5" />
        <!-- A copy of the track file of the last prerender, the temp.wav of UTAU, apart from the
             output file of the project -->
        <action id="helloutau.playback.saveLastPlayed" text="Save &amp;Last Played As..."
                category="Playback" />
        <!-- The whole track into a WAV file, by default the output file of the project, as
             Render WAV of UTAU -->
        <action id="helloutau.playback.renderTrack" text="Render &amp;Track to WAV..."
                category="Playback" />

        <!-- The voice bank of the project in its window, at the entry of the first selected note
             if a note is selected, as Ctrl+G in UTAU -->
        <action id="helloutau.tools.editVoiceBank" text="Edit &amp;Voice Bank" category="Tools"
                shortcut="Ctrl+G" />
        <!-- Deletes the fragments and the track file of the render cache of the project -->
        <action id="helloutau.tools.clearCache" text="&amp;Clear Render Cache" category="Tools" />
        <action id="helloutau.tools.viewRenderLog" text="View Render &amp;Log..." category="Tools" />
        <action id="helloutau.tools.settings" text="&amp;Settings..." category="Tools" />
        <action id="helloutau.help.about" text="About &amp;${APP_NAME}" category="Help" />
        <action id="helloutau.help.aboutQt" text="About &amp;Qt" category="Help" />

        <menu id="helloutau.mainMenu" topLevel="true" />
        <menu id="helloutau.file" text="&amp;File" />
        <menu id="helloutau.edit" text="&amp;Edit" />
        <menu id="helloutau.select" text="&amp;Select" />
        <menu id="helloutau.view" text="&amp;View" />
        <menu id="helloutau.playback" text="&amp;Playback" />
        <menu id="helloutau.tools" text="&amp;Tools" />
        <menu id="helloutau.help" text="&amp;Help" />
        <!-- Formats other than .usth, UST first; MIDI and the rest will join it -->
        <menu id="helloutau.file.export" text="&amp;Export" />
        <menu id="helloutau.edit.transpose" text="&amp;Transpose" />
        <menu id="helloutau.edit.envelope" text="E&amp;nvelope" />
        <menu id="helloutau.edit.reset" text="Rese&amp;t" />
        <menu id="helloutau.edit.timeline" text="&amp;Timeline" />

        <!-- The tool bar, which the window places -->
        <menu id="helloutau.mainToolBar" text="Main Toolbar" topLevel="true" />
    </items>

    <layouts>
        <menu id="helloutau.mainMenu">
            <menu id="helloutau.file">
                <action id="helloutau.file.new" />
                <action id="helloutau.file.open" />
                <action id="helloutau.file.openVoiceBank" />
                <action id="helloutau.file.openRecent" />
                <separator />
                <action id="helloutau.file.save" />
                <action id="helloutau.file.saveAs" />
                <menu id="helloutau.file.export" />
                <separator />
                <action id="helloutau.file.properties" />
                <separator />
                <action id="helloutau.file.close" />
                <action id="helloutau.file.quit" />
            </menu>
            <menu id="helloutau.edit">
                <action id="helloutau.edit.undo" />
                <action id="helloutau.edit.redo" />
                <separator />
                <action id="helloutau.edit.copy" />
                <action id="helloutau.edit.paste" />
                <action id="helloutau.edit.pasteParameters" />
                <action id="helloutau.edit.delete" />
                <separator />
                <action id="helloutau.edit.find" />
                <action id="helloutau.edit.replace" />
                <action id="helloutau.edit.findNext" />
                <action id="helloutau.edit.findPrevious" />
                <separator />
                <action id="helloutau.edit.insertNote" />
                <action id="helloutau.edit.insertRest" />
                <action id="helloutau.edit.splitNote" />
                <action id="helloutau.edit.combineNotes" />
                <action id="helloutau.edit.editLyric" />
                <action id="helloutau.edit.replaceLyrics" />
                <action id="helloutau.edit.setTempo" />
                <menu id="helloutau.edit.timeline">
                    <action id="helloutau.edit.setLabel" />
                    <action id="helloutau.edit.nameRegion" />
                    <action id="helloutau.edit.removeLabel" />
                    <action id="helloutau.edit.removeRegion" />
                </menu>
                <action id="helloutau.edit.noteProperties" />
                <separator />
                <action id="helloutau.edit.mode2" />
                <action id="helloutau.edit.convertPitchToMode1" />
                <action id="helloutau.edit.pitchControl" />
                <action id="helloutau.edit.scalePitch" />
                <menu id="helloutau.edit.reset" />
                <menu id="helloutau.edit.envelope" />
                <menu id="helloutau.edit.transpose" />
            </menu>
            <menu id="helloutau.select">
                <action id="helloutau.select.selectAll" />
                <separator />
                <action id="helloutau.select.selectTool" />
                <action id="helloutau.select.penTool" />
                <action id="helloutau.select.pitchTool" />
                <separator />
                <action id="helloutau.select.decreaseQuantizationInterval" />
                <action id="helloutau.select.increaseQuantizationInterval" />
            </menu>
            <menu id="helloutau.view">
                <action id="helloutau.view.showToolBar" />
                <separator />
                <action id="helloutau.view.timeSignature" />
                <separator />
                <action id="helloutau.view.showPitch" />
                <action id="helloutau.view.showRenderedPitch" />
                <action id="helloutau.view.showEnvelopes" />
                <action id="helloutau.view.showParameters" />
                <separator />
                <action id="helloutau.view.goToStart" />
                <action id="helloutau.view.goToEnd" />
                <action id="helloutau.view.goToFirstNote" />
                <action id="helloutau.view.goToLastNote" />
                <separator />
                <action id="helloutau.view.zoomInTime" />
                <action id="helloutau.view.zoomOutTime" />
                <action id="helloutau.view.zoomInKeys" />
                <action id="helloutau.view.zoomOutKeys" />
                <separator />
                <action id="helloutau.view.loadRegion" />
                <separator />
            </menu>
            <menu id="helloutau.playback">
                <action id="helloutau.playback.play" />
                <action id="helloutau.playback.stop" />
                <action id="helloutau.playback.replay" />
                <separator />
                <action id="helloutau.playback.saveLastPlayed" />
                <action id="helloutau.playback.renderTrack" />
            </menu>
            <menu id="helloutau.tools">
                <action id="helloutau.tools.editVoiceBank" />
                <separator />
                <action id="helloutau.tools.clearCache" />
                <action id="helloutau.tools.viewRenderLog" />
                <separator />
                <action id="helloutau.tools.settings" />
            </menu>
            <menu id="helloutau.help">
                <action id="helloutau.view.commandPalette" />
                <separator />
                <action id="helloutau.help.about" />
                <action id="helloutau.help.aboutQt" />
            </menu>
        </menu>
        <menu id="helloutau.mainToolBar">
            <action id="helloutau.edit.undo" />
            <action id="helloutau.edit.redo" />
            <separator />
            <action id="helloutau.select.selectTool" />
            <action id="helloutau.select.penTool" />
            <action id="helloutau.select.pitchTool" />
            <separator />
            <action id="helloutau.edit.mode2" />
            <action id="helloutau.edit.convertPitchToMode1" />
            <action id="helloutau.view.showPitch" />
            <action id="helloutau.view.showRenderedPitch" />
            <action id="helloutau.view.showEnvelopes" />
            <action id="helloutau.view.showParameters" />
            <separator />
            <action id="helloutau.edit.crossfadeP2P3" />
            <action id="helloutau.edit.crossfadeP1P4" />
            <action id="helloutau.edit.resetEnvelopes" />
            <separator />
            <action id="helloutau.select.quantizationWidget" />
            <separator />
            <action id="helloutau.edit.projectTempoWidget" />
            <separator />
            <action id="helloutau.view.timeSignatureWidget" />
            <separator />
            <action id="helloutau.playback.play" />
            <action id="helloutau.playback.stop" />
            <action id="helloutau.playback.replay" />
            <separator />
            <action id="helloutau.edit.find" />
        </menu>
        <menu id="helloutau.file.export">
            <action id="helloutau.file.exportUst" />
        </menu>
        <menu id="helloutau.edit.reset">
            <action id="helloutau.edit.resetPortamento" />
            <action id="helloutau.edit.resetVibratos" />
            <action id="helloutau.edit.resetEnvelopes" />
            <separator />
            <action id="helloutau.edit.resetAll" />
        </menu>
        <menu id="helloutau.edit.envelope">
            <action id="helloutau.edit.crossfadeP2P3" />
            <action id="helloutau.edit.crossfadeP1P4" />
        </menu>
        <menu id="helloutau.edit.transpose">
            <action id="helloutau.edit.transposeUp" />
            <action id="helloutau.edit.transposeDown" />
            <action id="helloutau.edit.octaveUp" />
            <action id="helloutau.edit.octaveDown" />
        </menu>
    </layouts>
</actionExtension>
