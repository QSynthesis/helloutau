<?xml version="1.0" encoding="UTF-8"?>
<!-- The menus and the commands of the dialog that edits frequency maps, registered with the
     action registry of that dialog. The commands that the windows have as well are declared again
     here, since each kind of window has a registry of its own and the shortcuts are set apart.
     See the editing in docs/FrequencyMaps.md. Format: docs/action-extension-spec.md in
     QActionKit. -->
<actionExtension>
    <version>1.0</version>
    <id>helloutau.frequencyMapEditor</id>

    <configuration>
        <vars>
            <var key="APP_NAME" value="HelloUtau" />
        </vars>
        <translationContext
            text="hello::daw::ActionText"
            category="hello::daw::ActionCategory"
            description="hello::daw::ActionDescription"
        />
    </configuration>

    <items>
        <!-- The commands that the windows have as well, of which the tools are in the project
             window only -->
        <action id="helloutau.file.save" text="&amp;Save" category="File" shortcut="Ctrl+S" />
        <action id="helloutau.file.close" text="&amp;Close" category="File" shortcut="Ctrl+W" />
        <action id="helloutau.edit.undo" text="&amp;Undo" category="Edit" shortcut="Ctrl+Z" />
        <action id="helloutau.edit.redo" text="&amp;Redo" category="Edit"
                shortcuts="Ctrl+Y;Ctrl+Shift+Z" />
        <action id="helloutau.select.selectAll" text="Select &amp;All" category="Select"
                shortcut="Ctrl+A" />
        <action id="helloutau.select.deselect" text="Desele&amp;ct" category="Select"
                shortcut="Ctrl+Shift+A" />
        <!-- The effect of a left drag in the editing area, as the tools of the piano roll -->
        <action id="helloutau.select.selectTool" text="&amp;Select Tool" category="Select"
                shortcut="V" />
        <action id="helloutau.select.penTool" text="P&amp;en Tool" category="Select" shortcut="B" />
        <action id="helloutau.playback.stop" text="&amp;Stop" category="Playback" shortcut="F7" />

        <!-- The audio file synthesized by the resampler of the settings with the map as edited,
             or the audio file as it is with $direct=True, or a stop of the playback. The Play
             button of the preview triggers this command. Return of the main keyboard and Enter of
             the keypad are distinct keys. -->
        <action id="helloutau.frequencyMap.synthesize" text="Synthesize and &amp;Play"
                category="Playback" shortcuts="Ctrl+Return;Ctrl+Enter" />

        <!-- The check of every map against the note of the recordings, as frqeditor does, and
             the corrections that it proposes. A correction is a run of frames, which the
             commands select in turn across the files. -->
        <action id="helloutau.frequencyMap.check" text="&amp;Check Frequency Maps..."
                category="Check" />
        <action id="helloutau.frequencyMap.previousCorrection" text="&amp;Previous Correction"
                category="Check" shortcut="Shift+F3" />
        <action id="helloutau.frequencyMap.nextCorrection" text="&amp;Next Correction"
                category="Check" shortcut="F3" />
        <!-- The selected correction, after which the next in the same direction is selected -->
        <action id="helloutau.frequencyMap.adoptCorrection" text="C&amp;orrect" category="Check" />
        <action id="helloutau.frequencyMap.ignoreCorrection" text="&amp;Ignore" category="Check" />
        <!-- Every correction of every map, each map as one step of its history -->
        <action id="helloutau.frequencyMap.adoptAllCorrections" text="Correct &amp;All"
                category="Check" />
        <!-- Every correction of every map, with no change of the frames -->
        <action id="helloutau.frequencyMap.ignoreAllCorrections" text="Ignore A&amp;ll"
                category="Check" />

        <!-- Every modified frequency map in order, as Save All of frqeditor -->
        <action id="helloutau.frequencyMap.saveAll" text="Save &amp;All" category="File"
                shortcut="Ctrl+Shift+S" />
        <!-- The current frequency map as last saved, as one step of its history -->
        <action id="helloutau.frequencyMap.revert" text="Re&amp;vert to Saved" category="Edit" />
        <!-- The selected frames as last saved, as Reload selected frequencies of frqeditor -->
        <action id="helloutau.frequencyMap.revertSelection" text="Revert Selected &amp;Frames"
                category="Edit" />
        <!-- The key to the mean of the voiced selected frames, as the button of frqeditor -->
        <action id="helloutau.frequencyMap.keyToAverage" text="Set &amp;Key to Average of Selection"
                category="Edit" />
        <!-- The voiced frames of the selection, as the buttons of frqeditor -->
        <action id="helloutau.frequencyMap.multiplyBy2" text="Multiply by &amp;2" category="Edit" />
        <action id="helloutau.frequencyMap.divideBy2" text="&amp;Divide by 2" category="Edit" />
        <action id="helloutau.frequencyMap.multiplyBy3" text="Multiply by &amp;3" category="Edit" />
        <action id="helloutau.frequencyMap.divideBy3" text="D&amp;ivide by 3" category="Edit" />
        <action id="helloutau.frequencyMap.unvoice" text="Unv&amp;oice" category="Edit"
                shortcut="Del" />
        <!-- Linear in hertz between the ends of the selection, as the avg button of frqeditor -->
        <action id="helloutau.frequencyMap.interpolate" text="I&amp;nterpolate" category="Edit" />
        <!-- Both axes by one of the seven zoom levels, as in frqeditor -->
        <action id="helloutau.frequencyMap.zoomIn" text="Zoom &amp;In" category="View" />
        <action id="helloutau.frequencyMap.zoomOut" text="Zoom &amp;Out" category="View" />
        <!-- The spectrogram in place of the rows of the keys, as the button s of frqeditor -->
        <action id="helloutau.frequencyMap.showSpectrogram" text="Show &amp;Spectrogram"
                category="View" />
        <!-- The color schemes and the brightness of the spectrogram, as in frqeditor -->
        <action id="helloutau.frequencyMap.coolColors" text="&amp;Cool" category="View" />
        <action id="helloutau.frequencyMap.purpleColors" text="&amp;Purple" category="View" />
        <action id="helloutau.frequencyMap.jadeColors" text="&amp;Jade" category="View" />
        <action id="helloutau.frequencyMap.grassyColors" text="&amp;Grassy" category="View" />
        <action id="helloutau.frequencyMap.flameColors" text="&amp;Flame" category="View" />
        <action id="helloutau.frequencyMap.rubyColors" text="&amp;Ruby" category="View" />
        <action id="helloutau.frequencyMap.brighten" text="&amp;Brighten" category="View" />
        <action id="helloutau.frequencyMap.darken" text="&amp;Darken" category="View" />
        <!-- The audio files of the list, as Ctrl+Up and Ctrl+Down of frqeditor -->
        <action id="helloutau.frequencyMap.previousFile" text="&amp;Previous File"
                category="View" shortcut="Ctrl+Up" />
        <action id="helloutau.frequencyMap.nextFile" text="&amp;Next File" category="View"
                shortcut="Ctrl+Down" />

        <menu id="helloutau.frequencyMapEditorMenu" topLevel="true" />
        <menu id="helloutau.frequencyMap.file" text="&amp;File" />
        <menu id="helloutau.frequencyMap.edit" text="&amp;Edit" />
        <menu id="helloutau.frequencyMap.select" text="&amp;Select" />
        <menu id="helloutau.frequencyMap.checkMenu" text="&amp;Check" />
        <menu id="helloutau.frequencyMap.view" text="&amp;View" />
        <menu id="helloutau.frequencyMap.playback" text="&amp;Playback" />
        <!-- The tool bar below the menu bar, which the dialog places -->
        <menu id="helloutau.frequencyMap.toolBar" text="Editing Toolbar" topLevel="true" />
        <menu id="helloutau.frequencyMap.spectrum" text="Spec&amp;trogram" />
        <menu id="helloutau.frequencyMap.colors" text="&amp;Colors" />
        <menu id="helloutau.frequencyMap.brightness" text="&amp;Brightness" />
    </items>

    <layouts>
        <menu id="helloutau.frequencyMapEditorMenu">
            <menu id="helloutau.frequencyMap.file">
                <action id="helloutau.file.save" />
                <action id="helloutau.frequencyMap.saveAll" />
                <separator />
                <action id="helloutau.file.close" />
            </menu>
            <menu id="helloutau.frequencyMap.edit">
                <action id="helloutau.edit.undo" />
                <action id="helloutau.edit.redo" />
                <separator />
                <action id="helloutau.frequencyMap.revert" />
                <action id="helloutau.frequencyMap.revertSelection" />
                <separator />
                <action id="helloutau.frequencyMap.multiplyBy2" />
                <action id="helloutau.frequencyMap.divideBy2" />
                <action id="helloutau.frequencyMap.multiplyBy3" />
                <action id="helloutau.frequencyMap.divideBy3" />
                <action id="helloutau.frequencyMap.unvoice" />
                <action id="helloutau.frequencyMap.interpolate" />
                <separator />
                <action id="helloutau.frequencyMap.keyToAverage" />
            </menu>
            <menu id="helloutau.frequencyMap.select">
                <action id="helloutau.select.selectAll" />
                <action id="helloutau.select.deselect" />
                <separator />
                <action id="helloutau.select.selectTool" />
                <action id="helloutau.select.penTool" />
            </menu>
            <menu id="helloutau.frequencyMap.checkMenu">
                <action id="helloutau.frequencyMap.check" />
                <separator />
                <action id="helloutau.frequencyMap.previousCorrection" />
                <action id="helloutau.frequencyMap.nextCorrection" />
                <separator />
                <action id="helloutau.frequencyMap.adoptCorrection" />
                <action id="helloutau.frequencyMap.ignoreCorrection" />
                <action id="helloutau.frequencyMap.adoptAllCorrections" />
                <action id="helloutau.frequencyMap.ignoreAllCorrections" />
            </menu>
            <menu id="helloutau.frequencyMap.view">
                <action id="helloutau.frequencyMap.zoomIn" />
                <action id="helloutau.frequencyMap.zoomOut" />
                <separator />
                <action id="helloutau.frequencyMap.previousFile" />
                <action id="helloutau.frequencyMap.nextFile" />
                <separator />
                <menu id="helloutau.frequencyMap.spectrum">
                    <action id="helloutau.frequencyMap.showSpectrogram" />
                    <menu id="helloutau.frequencyMap.colors">
                        <action id="helloutau.frequencyMap.coolColors" />
                        <action id="helloutau.frequencyMap.purpleColors" />
                        <action id="helloutau.frequencyMap.jadeColors" />
                        <action id="helloutau.frequencyMap.grassyColors" />
                        <action id="helloutau.frequencyMap.flameColors" />
                        <action id="helloutau.frequencyMap.rubyColors" />
                    </menu>
                    <menu id="helloutau.frequencyMap.brightness">
                        <action id="helloutau.frequencyMap.brighten" />
                        <action id="helloutau.frequencyMap.darken" />
                    </menu>
                </menu>
            </menu>
            <menu id="helloutau.frequencyMap.playback">
                <action id="helloutau.frequencyMap.synthesize" />
                <action id="helloutau.playback.stop" />
            </menu>
        </menu>
        <menu id="helloutau.frequencyMap.toolBar">
            <action id="helloutau.edit.undo" />
            <action id="helloutau.edit.redo" />
            <separator />
            <action id="helloutau.select.selectTool" />
            <action id="helloutau.select.penTool" />
            <separator />
            <action id="helloutau.frequencyMap.synthesize" />
            <action id="helloutau.playback.stop" />
            <separator />
            <action id="helloutau.frequencyMap.check" />
            <action id="helloutau.frequencyMap.previousCorrection" />
            <action id="helloutau.frequencyMap.nextCorrection" />
            <action id="helloutau.frequencyMap.adoptCorrection" />
            <action id="helloutau.frequencyMap.ignoreCorrection" />
            <action id="helloutau.frequencyMap.adoptAllCorrections" />
            <action id="helloutau.frequencyMap.ignoreAllCorrections" />
        </menu>
    </layouts>
</actionExtension>
