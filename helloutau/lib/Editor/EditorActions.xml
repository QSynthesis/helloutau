<?xml version="1.0" encoding="UTF-8"?>
<!-- The menus of the editor window. Format: docs/action-extension-spec.md in QActionKit. -->
<actionExtension>
    <version>1.0</version>
    <id>helloutau.editor</id>

    <configuration>
        <translationContext
            text="hello::daw::ActionText"
            category="hello::daw::ActionCategory"
            description="hello::daw::ActionDescription"
        />
    </configuration>

    <items>
        <action id="helloutau.file.new" text="&amp;New" category="File" shortcut="Ctrl+N" />
        <action id="helloutau.file.open" text="&amp;Open..." category="File" shortcut="Ctrl+O" />
        <!-- A folder, opened in a voice bank window (docs/VoiceBankEditor.md) -->
        <action id="helloutau.file.openVoiceBank" text="Open &amp;Voice Bank..." category="File" />
        <!-- Filled by the window with the files last opened -->
        <action id="helloutau.file.openRecent" text="Open &amp;Recent" category="File"
                external="true" />
        <action id="helloutau.file.save" text="&amp;Save" category="File" shortcut="Ctrl+S" />
        <action id="helloutau.file.saveAs" text="Save &amp;As..." category="File"
                shortcut="Ctrl+Shift+S" />
        <action id="helloutau.file.exportUst" text="&amp;UST..." category="File" />
        <!-- The name, tempo, flags, output file, voice folder, engines and Mode2 of the project -->
        <action id="helloutau.file.properties" text="Project &amp;Properties..." category="File" />
        <action id="helloutau.file.close" text="&amp;Close" category="File" shortcut="Ctrl+W" />
        <action id="helloutau.file.quit" text="&amp;Quit" category="File" shortcut="Ctrl+Q" />

        <action id="helloutau.edit.undo" text="&amp;Undo" category="Edit" shortcut="Ctrl+Z" />
        <action id="helloutau.edit.redo" text="&amp;Redo" category="Edit"
                shortcuts="Ctrl+Y;Ctrl+Shift+Z" />
        <action id="helloutau.edit.delete" text="&amp;Delete" category="Edit"
                shortcuts="Del;Shift+Del" />
        <action id="helloutau.edit.selectAll" text="Select &amp;All" category="Edit"
                shortcut="Ctrl+A" />
        <action id="helloutau.edit.insertNote" text="&amp;Insert Note" category="Edit"
                shortcut="Ins" />
        <action id="helloutau.edit.splitNote" text="S&amp;plit Note..." category="Edit" />
        <!-- A rest before the first selected note, as UTAU inserts one -->
        <action id="helloutau.edit.insertRest" text="Insert &amp;Rest" category="Edit"
                shortcut="Ctrl+R" />
        <!-- The selected notes into the first, their lengths summed, as UTAU merges them -->
        <action id="helloutau.edit.mergeNotes" text="Mer&amp;ge Notes" category="Edit"
                shortcut="Ctrl+U" />
        <!-- The tempo of the first selected note, from which it applies -->
        <action id="helloutau.edit.setTempo" text="Set Te&amp;mpo..." category="Edit" />
        <!-- The properties of the selected notes, as the note property dialog of UTAU -->
        <action id="helloutau.edit.noteProperties" text="Note Propert&amp;ies..." category="Edit"
                shortcut="Ctrl+E" />
        <!-- Checked while the project turns Mode2 on -->
        <action id="helloutau.edit.mode2" text="Mode&amp;2 Pitch" category="Edit" />
        <action id="helloutau.edit.togglePortamento" text="Add or Remove P&amp;ortamento"
                category="Edit" />
        <action id="helloutau.edit.toggleVibrato" text="Add or Remove &amp;Vibrato"
                category="Edit" />
        <action id="helloutau.edit.editVibrato" text="Vibra&amp;to..." category="Edit" />
        <action id="helloutau.edit.scalePitch" text="Scale Pitc&amp;h..." category="Edit" />
        <action id="helloutau.edit.crossfadeP2P3" text="Crossfade (p&amp;2, p3)" category="Envelope" />
        <action id="helloutau.edit.crossfadeP1P4" text="Crossfade (p&amp;1, p4)" category="Envelope" />
        <action id="helloutau.edit.copy" text="&amp;Copy" category="Edit" shortcut="Ctrl+C" />
        <action id="helloutau.edit.paste" text="&amp;Paste" category="Edit" shortcut="Ctrl+V" />
        <action id="helloutau.edit.pasteParameters" text="Paste Para&amp;meters..." category="Edit"
                shortcut="Ctrl+Shift+V" />
        <action id="helloutau.edit.resetPortamento" text="&amp;Pitch Points" category="Reset" />
        <action id="helloutau.edit.resetVibratos" text="&amp;Vibratos" category="Reset" />
        <action id="helloutau.edit.resetEnvelopes" text="&amp;Envelopes" category="Reset" />
        <action id="helloutau.edit.resetAll" text="&amp;All" category="Reset" />
        <action id="helloutau.edit.editLyric" text="Edit &amp;Lyric" category="Edit"
                shortcut="F2" />
        <action id="helloutau.edit.transposeUp" text="&amp;Up a Semitone" category="Transpose"
                shortcut="Ctrl+Up" />
        <action id="helloutau.edit.transposeDown" text="&amp;Down a Semitone"
                category="Transpose" shortcut="Ctrl+Down" />
        <action id="helloutau.edit.octaveUp" text="Up an &amp;Octave" category="Transpose"
                shortcut="Ctrl+Shift+Up" />
        <action id="helloutau.edit.octaveDown" text="Down an O&amp;ctave" category="Transpose"
                shortcut="Ctrl+Shift+Down" />
        <action id="helloutau.edit.selectTool" text="&amp;Select Tool" category="Edit"
                shortcut="V" />
        <action id="helloutau.edit.penTool" text="P&amp;en Tool" category="Edit" shortcut="B" />
        <action id="helloutau.edit.pitchTool" text="&amp;Freehand Pitch Tool" category="Edit"
                shortcut="F" />

        <action id="helloutau.view.showPitch" text="Show &amp;Pitch" category="View"
                shortcut="F4" />
        <!-- The envelope of each note above its bar, from where its pre-utterance starts, as
             UTAU draws it -->
        <action id="helloutau.view.showEnvelopes" text="Show &amp;Envelopes" category="View" />
        <action id="helloutau.view.commandPalette" text="&amp;Command Palette..." category="View"
                shortcuts="Ctrl+Shift+P;F1" />

        <!-- Plays, pauses what plays, or goes on from where it was paused -->
        <action id="helloutau.playback.play" text="&amp;Play or Pause" category="Playback"
                shortcuts="Space;F5" />

        <action id="helloutau.playback.pause" text="Pa&amp;use or Resume" category="Playback"
                shortcut="F6" />
        <action id="helloutau.playback.stop" text="&amp;Stop" category="Playback" shortcut="F7" />
        <!-- Plays the last playback again from its start, the last render without the engines
             while its notes stay the same -->
        <action id="helloutau.playback.replay" text="&amp;Replay" category="Playback"
                shortcut="Shift+F5" />

        <action id="helloutau.tools.settings" text="&amp;Settings..." category="Tools" />
        <!-- The voice bank of the project, in its window -->
        <action id="helloutau.tools.editVoiceBank" text="Edit &amp;Voice Bank" category="Tools"
                shortcut="Ctrl+G" />
        <!-- The entry that the first selected note uses, in the window of the voice bank -->
        <action id="helloutau.tools.showEntry" text="Go to Voice Bank &amp;Entry" category="Tools" />
        <!-- Deletes the fragments and the track file of the render cache of the project -->
        <action id="helloutau.tools.clearCache" text="&amp;Clear Render Cache" category="Tools" />

        <menu id="helloutau.mainMenu" topLevel="true" />
        <menu id="helloutau.file" text="&amp;File" />
        <!-- Formats other than .usth, UST first; MIDI and the rest will join it -->
        <menu id="helloutau.file.export" text="&amp;Export" />
        <menu id="helloutau.edit" text="&amp;Edit" />
        <menu id="helloutau.edit.transpose" text="&amp;Transpose" />
        <menu id="helloutau.edit.envelope" text="E&amp;nvelope" />
        <menu id="helloutau.edit.reset" text="Rese&amp;t" />
        <menu id="helloutau.view" text="&amp;View" />
        <menu id="helloutau.playback" text="&amp;Playback" />
        <menu id="helloutau.tools" text="&amp;Tools" />

        <!-- The menus of the voice bank window -->
        <!-- Every folder of the voice bank read again, whatever the stamps of its files, as the
             refresh of UTAU -->
        <action id="helloutau.voiceBank.reloadAll" text="Re&amp;load All from Disk" category="File" />
        <!-- An entry for an audio file of the folder, whose alias the table then edits -->
        <action id="helloutau.voiceBank.insertEntry" text="&amp;Insert Entry..." category="Edit"
                shortcut="Ins" />
        <!-- A copy of each selected entry, its alias followed by a free number -->
        <action id="helloutau.voiceBank.duplicateEntries" text="D&amp;uplicate Entries"
                category="Edit" shortcut="Ctrl+D" />
        <!-- An entry with an empty alias for each selected audio file without one -->
        <action id="helloutau.voiceBank.includeAudio" text="Include Audio &amp;Files"
                category="Edit" />
        <!-- A value of the current entry at the time under the pointer, while the pointer is over
             the waveform; the keys are those of OpenUtau -->
        <action id="helloutau.voiceBank.setOffset" text="&amp;Offset" category="Set at Pointer"
                shortcut="1" />
        <action id="helloutau.voiceBank.setOverlap" text="O&amp;verlap" category="Set at Pointer"
                shortcut="2" />
        <action id="helloutau.voiceBank.setPreUtterance" text="&amp;Pre-utterance"
                category="Set at Pointer" shortcut="3" />
        <action id="helloutau.voiceBank.setConsonant" text="&amp;Consonant"
                category="Set at Pointer" shortcut="4" />
        <action id="helloutau.voiceBank.setCutoff" text="C&amp;utoff" category="Set at Pointer"
                shortcut="5" />
        <!-- The audio file of the current entry, or a stop of what plays -->
        <action id="helloutau.voiceBank.playAudio" text="&amp;Play Audio File" category="Playback"
                shortcut="Space" />
        <action id="helloutau.voiceBank.playSpan" text="Play from &amp;Offset to Cutoff"
                category="Playback" shortcut="Shift+Space" />
        <!-- From the time under the pointer, while the pointer is over the waveform; a double
             click there does the same -->
        <action id="helloutau.voiceBank.playFromPointer" text="Play from Poi&amp;nter"
                category="Playback" shortcut="P" />
        <!-- A note of the current entry by the resampler of the settings, at the pitch and of
             the length beside the waveform -->
        <action id="helloutau.voiceBank.synthesize" text="&amp;Synthesize Note" category="Playback"
                shortcut="Ctrl+Return" />
        <!-- The dock of character.txt, readme.txt and prefix.map -->
        <action id="helloutau.voiceBank.showInfo" text="Voice Bank &amp;Info" category="View" />
        <!-- The folder chosen in the tree: its files saved in another encoding, the text staying,
             or read again in another encoding, the bytes staying -->
        <action id="helloutau.voiceBank.convertCharset" text="Con&amp;vert Encoding..."
                category="Edit" />
        <action id="helloutau.voiceBank.rereadCharset" text="Read Again in &amp;Encoding..."
                category="Edit" />
        <!-- The chunks of the audio files besides the format and the audio, written away after
             a confirmation -->
        <action id="helloutau.voiceBank.removeMetadata" text="Remove Audio &amp;Metadata..."
                category="Tools" />

        <menu id="helloutau.voiceBankMenu" topLevel="true" />
        <menu id="helloutau.voiceBank.file" text="&amp;File" />
        <menu id="helloutau.voiceBank.edit" text="&amp;Edit" />
        <menu id="helloutau.voiceBank.setValue" text="&amp;Set at Pointer" />
        <menu id="helloutau.voiceBank.view" text="&amp;View" />
        <menu id="helloutau.voiceBank.playback" text="&amp;Playback" />
        <menu id="helloutau.voiceBank.tools" text="&amp;Tools" />
    </items>

    <layouts>
        <menu id="helloutau.mainMenu">
            <menu id="helloutau.file">
                <action id="helloutau.file.new" />
                <action id="helloutau.file.open" />
                <action id="helloutau.file.openVoiceBank" />
                <action id="helloutau.file.openRecent" />
                <separator />
                <action id="helloutau.file.save" />
                <action id="helloutau.file.saveAs" />
                <menu id="helloutau.file.export">
                    <action id="helloutau.file.exportUst" />
                </menu>
                <separator />
                <action id="helloutau.file.properties" />
                <separator />
                <action id="helloutau.file.close" />
                <action id="helloutau.file.quit" />
            </menu>
            <menu id="helloutau.edit">
                <action id="helloutau.edit.undo" />
                <action id="helloutau.edit.redo" />
                <separator />
                <action id="helloutau.edit.copy" />
                <action id="helloutau.edit.paste" />
                <action id="helloutau.edit.pasteParameters" />
                <action id="helloutau.edit.delete" />
                <action id="helloutau.edit.selectAll" />
                <separator />
                <action id="helloutau.edit.insertNote" />
                <action id="helloutau.edit.insertRest" />
                <action id="helloutau.edit.splitNote" />
                <action id="helloutau.edit.mergeNotes" />
                <action id="helloutau.edit.editLyric" />
                <action id="helloutau.edit.setTempo" />
                <action id="helloutau.edit.noteProperties" />
                <separator />
                <action id="helloutau.edit.mode2" />
                <action id="helloutau.edit.togglePortamento" />
                <action id="helloutau.edit.toggleVibrato" />
                <action id="helloutau.edit.editVibrato" />
                <action id="helloutau.edit.scalePitch" />
                <menu id="helloutau.edit.reset">
                    <action id="helloutau.edit.resetPortamento" />
                    <action id="helloutau.edit.resetVibratos" />
                    <action id="helloutau.edit.resetEnvelopes" />
                    <separator />
                    <action id="helloutau.edit.resetAll" />
                </menu>
                <menu id="helloutau.edit.envelope">
                    <action id="helloutau.edit.crossfadeP2P3" />
                    <action id="helloutau.edit.crossfadeP1P4" />
                </menu>
                <menu id="helloutau.edit.transpose">
                    <action id="helloutau.edit.transposeUp" />
                    <action id="helloutau.edit.transposeDown" />
                    <action id="helloutau.edit.octaveUp" />
                    <action id="helloutau.edit.octaveDown" />
                </menu>
                <separator />
                <action id="helloutau.edit.selectTool" />
                <action id="helloutau.edit.penTool" />
                <action id="helloutau.edit.pitchTool" />
            </menu>
            <menu id="helloutau.view">
                <action id="helloutau.view.showPitch" />
                <action id="helloutau.view.showEnvelopes" />
                <separator />
                <action id="helloutau.view.commandPalette" />
            </menu>
            <menu id="helloutau.playback">
                <action id="helloutau.playback.play" />
                <action id="helloutau.playback.pause" />
                <action id="helloutau.playback.stop" />
                <action id="helloutau.playback.replay" />
            </menu>
            <menu id="helloutau.tools">
                <action id="helloutau.tools.editVoiceBank" />
                <action id="helloutau.tools.showEntry" />
                <action id="helloutau.tools.clearCache" />
                <separator />
                <action id="helloutau.tools.settings" />
            </menu>
        </menu>
        <menu id="helloutau.voiceBankMenu">
            <menu id="helloutau.voiceBank.file">
                <action id="helloutau.file.new" />
                <action id="helloutau.file.open" />
                <action id="helloutau.file.openVoiceBank" />
                <action id="helloutau.file.openRecent" />
                <separator />
                <action id="helloutau.file.save" />
                <action id="helloutau.file.saveAs" />
                <action id="helloutau.voiceBank.reloadAll" />
                <separator />
                <action id="helloutau.file.close" />
                <action id="helloutau.file.quit" />
            </menu>
            <menu id="helloutau.voiceBank.edit">
                <action id="helloutau.edit.undo" />
                <action id="helloutau.edit.redo" />
                <separator />
                <action id="helloutau.voiceBank.insertEntry" />
                <action id="helloutau.voiceBank.duplicateEntries" />
                <action id="helloutau.voiceBank.includeAudio" />
                <action id="helloutau.edit.delete" />
                <separator />
                <menu id="helloutau.voiceBank.setValue">
                    <action id="helloutau.voiceBank.setOffset" />
                    <action id="helloutau.voiceBank.setOverlap" />
                    <action id="helloutau.voiceBank.setPreUtterance" />
                    <action id="helloutau.voiceBank.setConsonant" />
                    <action id="helloutau.voiceBank.setCutoff" />
                </menu>
                <separator />
                <action id="helloutau.voiceBank.convertCharset" />
                <action id="helloutau.voiceBank.rereadCharset" />
            </menu>
            <menu id="helloutau.voiceBank.view">
                <action id="helloutau.voiceBank.showInfo" />
                <separator />
                <action id="helloutau.view.commandPalette" />
            </menu>
            <menu id="helloutau.voiceBank.playback">
                <action id="helloutau.voiceBank.playAudio" />
                <action id="helloutau.voiceBank.playSpan" />
                <action id="helloutau.voiceBank.playFromPointer" />
                <action id="helloutau.voiceBank.synthesize" />
                <separator />
                <action id="helloutau.playback.stop" />
            </menu>
            <menu id="helloutau.voiceBank.tools">
                <action id="helloutau.voiceBank.removeMetadata" />
                <separator />
                <action id="helloutau.tools.settings" />
            </menu>
        </menu>
    </layouts>
</actionExtension>
