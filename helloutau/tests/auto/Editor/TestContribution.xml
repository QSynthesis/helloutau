<?xml version="1.0" encoding="UTF-8"?>
<actionExtension>

    <version>1.0</version>
    <id>org.helloutau.test.contribution</id>

    <items>
        <action id="test.contribution.hello" text="Hello" category="Test" />
        <!-- A menu that the contribution fills -->
        <action id="test.contribution.menu" text="Hello Menu" category="Test" triggerable="false" />
    </items>

    <!-- Into the Tools menu of the project window -->
    <insertions>
        <insertion target="helloutau.tools">
            <action id="test.contribution.hello" />
            <action id="test.contribution.menu" />
        </insertion>
    </insertions>

</actionExtension>
